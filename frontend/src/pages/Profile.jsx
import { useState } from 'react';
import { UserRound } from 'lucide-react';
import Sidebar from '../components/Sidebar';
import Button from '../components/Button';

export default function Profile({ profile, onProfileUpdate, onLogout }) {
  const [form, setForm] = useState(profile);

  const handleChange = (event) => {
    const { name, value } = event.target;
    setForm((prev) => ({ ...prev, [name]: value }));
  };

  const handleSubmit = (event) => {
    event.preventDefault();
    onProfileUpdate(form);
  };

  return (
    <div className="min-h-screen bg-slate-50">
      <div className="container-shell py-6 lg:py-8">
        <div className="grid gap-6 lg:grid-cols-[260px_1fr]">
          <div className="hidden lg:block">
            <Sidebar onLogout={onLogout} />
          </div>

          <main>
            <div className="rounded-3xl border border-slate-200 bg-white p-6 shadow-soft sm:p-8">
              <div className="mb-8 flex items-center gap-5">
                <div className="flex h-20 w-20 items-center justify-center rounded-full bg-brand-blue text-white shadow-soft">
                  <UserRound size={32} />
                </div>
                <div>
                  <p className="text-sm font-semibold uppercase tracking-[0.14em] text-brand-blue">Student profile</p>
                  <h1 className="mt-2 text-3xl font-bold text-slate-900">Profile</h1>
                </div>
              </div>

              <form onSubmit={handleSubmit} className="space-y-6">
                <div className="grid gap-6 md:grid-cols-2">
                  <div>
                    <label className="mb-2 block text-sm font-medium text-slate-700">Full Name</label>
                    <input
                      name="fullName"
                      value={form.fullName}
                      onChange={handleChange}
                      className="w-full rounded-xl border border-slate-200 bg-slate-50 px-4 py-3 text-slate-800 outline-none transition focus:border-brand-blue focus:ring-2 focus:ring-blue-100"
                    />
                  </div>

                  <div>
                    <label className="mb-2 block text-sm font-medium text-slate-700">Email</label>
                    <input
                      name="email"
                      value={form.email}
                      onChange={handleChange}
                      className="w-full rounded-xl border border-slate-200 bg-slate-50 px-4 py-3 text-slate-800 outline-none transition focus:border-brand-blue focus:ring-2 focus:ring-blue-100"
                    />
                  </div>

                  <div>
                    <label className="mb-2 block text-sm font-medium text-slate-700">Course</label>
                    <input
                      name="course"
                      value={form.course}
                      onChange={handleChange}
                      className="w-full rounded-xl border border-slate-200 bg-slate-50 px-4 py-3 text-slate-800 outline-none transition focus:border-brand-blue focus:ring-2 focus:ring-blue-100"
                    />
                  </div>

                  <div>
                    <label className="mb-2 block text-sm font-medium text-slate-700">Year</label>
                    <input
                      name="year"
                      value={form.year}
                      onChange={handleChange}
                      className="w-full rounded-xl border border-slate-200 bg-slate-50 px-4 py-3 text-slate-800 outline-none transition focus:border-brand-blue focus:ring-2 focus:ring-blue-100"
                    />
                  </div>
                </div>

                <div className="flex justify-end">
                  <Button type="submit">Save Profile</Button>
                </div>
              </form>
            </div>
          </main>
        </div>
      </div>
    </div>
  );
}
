import { useNavigate, useParams } from 'react-router-dom';
import TaskForm from '../components/TaskForm';
import Sidebar from '../components/Sidebar';

export default function EditTask({ tasks, onUpdateTask, onLogout }) {
  const navigate = useNavigate();
  const { id } = useParams();
  const task = tasks.find((item) => String(item.id) === String(id));

  if (!task) {
    return (
      <div className="container-shell py-12 text-center">
        <p className="text-lg font-medium text-slate-700">Task not found.</p>
      </div>
    );
  }

  const handleSubmit = (taskData) => {
    onUpdateTask(task.id, taskData);
    navigate('/tasks');
  };

  return (
    <div className="min-h-screen bg-slate-50">
      <div className="container-shell py-6 lg:py-8">
        <div className="grid gap-6 lg:grid-cols-[260px_1fr]">
          <div className="hidden lg:block">
            <Sidebar onLogout={onLogout} />
          </div>

          <main>
            <div className="rounded-3xl border border-slate-200 bg-white p-6 shadow-soft">
              <div className="mb-8">
                <p className="text-sm font-semibold uppercase tracking-[0.14em] text-brand-purple">Edit task</p>
                <h1 className="mt-2 text-3xl font-bold text-slate-900">Edit Task</h1>
              </div>

              <TaskForm
                initialData={task}
                onSubmit={handleSubmit}
                submitLabel="Save Changes"
                cancelTo="/tasks"
              />
            </div>
          </main>
        </div>
      </div>
    </div>
  );
}
